<h1>選手情報入力</h1>

<%= form_with model: @game do |form| %>
  <%= form.hidden_field :match_id, value: @match.id %>
  <%= form.hidden_field :number, value: @match.games.count + 1 %>
  
  <h2>P側</h2>

  <div>
    <%= form.label :p_school, "P高校名" %>
    <%= form.text_field :p_school %>
  </div>

  <div>
    <%= form.label :p_back, "P後衛" %>
    <%= form.text_field :p_back %>
  </div>

  <div>
    <%= form.label :p_front, "P前衛" %>
    <%= form.text_field :p_front %>
  </div>

  <hr>

  <h2>Q側</h2>

  <div>
    <%= form.label :q_school, "Q高校名" %>
    <%= form.text_field :q_school %>
  </div>

  <div>
    <%= form.label :q_back, "Q後衛" %>
    <%= form.text_field :q_back %>
  </div>

  <div>
    <%= form.label :q_front, "Q前衛" %>
    <%= form.text_field :q_front %>
  </div>

  <br>

  <%= form.submit "Play ball" %>

<% end %>