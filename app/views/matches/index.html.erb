<h1>試合一覧</h1>

<%= form_with url: matches_path, method: :get, local: true do |form| %>

  <%= form.text_field :keyword,
      value: params[:keyword],
      placeholder: "試合名・高校名・選手名で検索" %>

  <%= form.submit "検索" %>

<% end %>


<% @matches.each do |match| %>

  <div class="match-card">

    <h2>
      <%= match.title %>
      <span class="match-count">
        （<%= match.games.count %>試合）
      </span>
    </h2>

    <p>
      <strong>試合名：</strong>
      <%= match.title %>
    </p>

    <p>
      <strong>コート：</strong>
      <%= match.court %>
    </p>

    <p>
      <strong>日付：</strong>
      <%= match.date&.strftime("%Y/%m/%d") %>
    </p>

    <%= link_to "この試合を見る",
        match,
        class: "match-view-button" %>

  </div>

<% end %>


<%= link_to "新しい試合",
    new_match_path,
    class: "new-match-button" %>