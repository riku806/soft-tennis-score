<%= form_with(model: game) do |form| %>
  <% if game.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(game.errors.count, "error") %> prohibited this game from being saved:</h2>

      <ul>
        <% game.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :match_id, style: "display: block" %>
    <%= form.text_field :match_id %>
  </div>

  <div>
    <%= form.label :number, style: "display: block" %>
    <%= form.number_field :number %>
  </div>

  <div>
    <%= form.label :p_score, style: "display: block" %>
    <%= form.number_field :p_score %>
  </div>

  <div>
    <%= form.label :q_score, style: "display: block" %>
    <%= form.number_field :q_score %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
