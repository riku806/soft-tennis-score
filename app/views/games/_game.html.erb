<div id="<%= dom_id game %>">
  <p>
    <strong>Match:</strong>
    <%= game.match_id %>
  </p>

  <p>
    <strong>Number:</strong>
    <%= game.number %>
  </p>

  <p>
    <strong>P score:</strong>
    <%= game.p_score %>
  </p>

  <p>
    <strong>Q score:</strong>
    <%= game.q_score %>
  </p>

</div>
