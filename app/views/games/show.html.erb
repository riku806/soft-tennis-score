    FStP
    FStBO
    FStSO
    FStNinP
    FStN
    FStM

    BStP
    BStBO
    BStSO
    BStNinP
    BStN
    BStM
  ],

  "ボレー" => %w[
    FLVP
    FLVN
    FLVBO
    FLVSO
    FLVNinP

    BLVP
    BLVN
    BLVBO
    BLVSO
    BLVNinP

    FVP
