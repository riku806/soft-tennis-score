    when 4 then "④"
    else q_games
    end
%>

<div class="vs-mark">
  <span class="game-count"><%= p_display %></span>
  -
  <span class="game-count"><%= q_display %></span>
</div>

  <div class="team-side">
    <div class="school"><%= @game.q_school %></div>
    <div class="players">
      <%= @game.q_front %>・<%= @game.q_back %>
    </div>
  </div>

</div>

<div class="score-board">
  <div>
    P<br>
    <%= @game.p_score || 0 %>
  </div>

  <div>
    Q<br>
    <%= @game.q_score || 0 %>
  </div>
</div>

<!-- =========================
     スコア入力選択画面
========================= -->

<div class="score-input-area">

  <!-- ① サーブを誰が打つ？ -->
  <h2>サーブを誰が打つ？</h2>

  <div class="player-select">

    <button type="button"
            class="select-btn"
            data-group="server"
            data-value="<%= @game.p_back %>">
      <%= @game.p_back %>
    </button>

    <button type="button"
            class="select-btn"
            data-group="server"
            data-value="<%= @game.p_front %>">
      <%= @game.p_front %>
    </button>

    <button type="button"
            class="select-btn"
            data-group="server"
            data-value="<%= @game.q_back %>">
      <%= @game.q_back %>
    </button>

    <button type="button"
            class="select-btn"
            data-group="server"
            data-value="<%= @game.q_front %>">
      <%= @game.q_front %>
    </button>

  </div>


  <!-- ② ファースト / セカンド -->
  <div id="serve-area" style="display:none;">

    <h2>サーブ</h2>

    <div class="player-select">

      <button type="button"
              class="select-btn"
              data-group="serve"
              data-value="first">
        ファースト
      </button>

      <button type="button"
              class="select-btn"
              data-group="serve"
              data-value="second">
        セカンド
      </button>

    </div>

  </div>


  <!-- ③ 誰のプレー？ -->
  <div id="player-area" style="display:none;">

    <h2>誰のプレー？</h2>

    <div class="player-select">

      <button type="button"
              class="select-btn"
              data-group="player"
              data-value="<%= @game.p_back %>">
        <%= @game.p_back %>
      </button>

      <button type="button"
              class="select-btn"
              data-group="player"
              data-value="<%= @game.p_front %>">
        <%= @game.p_front %>
      </button>

      <button type="button"
              class="select-btn"
              data-group="player"
              data-value="<%= @game.q_back %>">
        <%= @game.q_back %>
      </button>

      <button type="button"
              class="select-btn"
              data-group="player"
              data-value="<%= @game.q_front %>">
        <%= @game.q_front %>
      </button>

    </div>

  </div>


  <!-- ④ カテゴリー -->
  <div id="category-area" style="display:none;">

    <h2>カテゴリー</h2>

    <div class="player-select">

      <% [
        "サーブ",
        "レシーブ",
        "ストローク",
        "ボレー",
        "スマッシュ",
        "その他"
      ].each do |category| %>

        <button type="button"
                class="select-btn"
                data-group="category"
                data-value="<%= category %>">
          <%= category %>
        </button>

      <% end %>

    </div>

  </div>


  <!-- ⑤ ポイント / ミス -->
  <div id="result-type-area" style="display:none;">

    <h2>ポイント・ミス</h2>

    <div class="player-select">

      <button type="button"
              class="select-btn"
              data-group="result_type"
              data-value="point">
        ポイント
      </button>

      <button type="button"
              class="select-btn"
              data-group="result_type"
              data-value="miss">
        ミス
      </button>

    </div>

  </div>


  <!-- ⑥ プレーコード -->
  <div id="code-area" style="display:none;">

    <h2 id="code-title"></h2>

    <div class="player-select">

      <% play_codes.each do |category, codes| %>

        <% codes.each do |code| %>

          <%
            is_point =
              code == "SA" ||
              code.end_with?("P") ||
              code.end_with?("NinP")
          %>

          <%= button_to(
                is_point ? "◯#{code}" : "✕#{code}",
                play_game_path(@game),
                method: :post,
                params: {
                  player: "",
                  server: "",
                  serve: "",
                  code: code
                },
                class: "code-btn",
                data: {
                  category: category,
                  result_type: is_point ? "point" : "miss",
                  code: code
                }
              ) %>

        <% end %>

      <% end %>

    </div>

  </div>

</div>

<script>
document.addEventListener("DOMContentLoaded", function() {

  let selected = {
    server: "",
    serve: "",
    player: "",
    category: "",
    result_type: ""
  };

  const buttons = document.querySelectorAll(".select-btn");

  buttons.forEach(function(button) {

    button.addEventListener("click", function() {

      const group = button.dataset.group;
      const value = button.dataset.value;

      // 選択を保存
      selected[group] = value;

      // 同じグループのボタンを青に戻す
      document
        .querySelectorAll('.select-btn[data-group="' + group + '"]')
        .forEach(function(btn) {
          btn.classList.remove("selected-btn");
        });

      // 押したボタンだけ赤
      button.classList.add("selected-btn");


      // =========================
      // サーブを誰が打つ？
      // =========================
      if (group === "server") {

        document.getElementById("serve-area").style.display = "block";

      }


      // =========================
      // ファースト / セカンド
      // =========================
      if (group === "serve") {

        document.getElementById("player-area").style.display = "block";

      }


      // =========================
      // 誰のプレー？
      // =========================
      if (group === "player") {

        document.getElementById("category-area").style.display = "block";

      }


      // =========================
      // カテゴリー
      // =========================
      if (group === "category") {

        document.getElementById("result-type-area").style.display = "block";

        document.getElementById("code-area").style.display = "none";

        // ポイント・ミスを一度リセット
        selected.result_type = "";

        document
          .querySelectorAll('.select-btn[data-group="result_type"]')
          .forEach(function(btn) {
            btn.classList.remove("selected-btn");
          });

      }


      // =========================
      // ポイント / ミス
      // =========================
      if (group === "result_type") {

        document.getElementById("code-area").style.display = "block";

        document.getElementById("code-title").textContent =
          selected.category;

        showCodes();

      }

    });

  });


  // =========================
  // プレーコードを表示
  // =========================
  function showCodes() {
  const category = selected.category;
  const resultType = selected.result_type;

  const codeButtons = document.querySelectorAll(".code-btn");

  codeButtons.forEach(function(button) {

    const buttonCategory = button.dataset.category;
    const buttonResult = button.dataset.resultType;

    if (
      buttonCategory === category &&
      buttonResult === resultType
    ) {
      button.style.display = "inline-block";
    } else {
      button.style.display = "none";
    }

  });

  // プレーボタンに現在の選択内容をセット
  document.querySelectorAll(".code-btn").forEach(function(button) {

    const form = button.closest("form");
    if (!form) return;

    const playerInput =
      form.querySelector('input[name="player"]');

    const serverInput =
      form.querySelector('input[name="server"]');

    const serveInput =
      form.querySelector('input[name="serve"]');

    if (playerInput) {
      playerInput.value = selected.player;
    }

    if (serverInput) {
      serverInput.value = selected.server;
    }

    if (serveInput) {
      serveInput.value = selected.serve;
    }

  });
}

});
</script>

