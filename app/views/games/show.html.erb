                  .where.not(winner: "RESULT")
                  .order(:created_at)
%>

<% points.each do |point| %>

  <%
    number = all_points.index(point) + 1
 if point.serve_number == "first"
  marks = ["①","②","③","④","⑤","⑥","⑦","⑧","⑨","⑩"]
  mark = marks[number - 1] || number
else
  mark = number
end

    display_code =
      if point.play_code == "SA" ||
         point.play_code.end_with?("P") ||
         point.play_code.end_with?("NinP")
        "◯#{point.play_code}"
      else
        "✕#{point.play_code}"
      end
  %>

  <div><%= mark %><%= display_code %></div>

<% end %>
</div>

<div class="player-box">
  <h3>Q前衛 <%= @game.q_front %></h3>
  <% points = @game.points.where(player: @game.q_front)
                          .where(game_number: @game.current_game_number)
                          .where.not(winner: "RESULT")
                          .order(:created_at) %>
<%
all_points = @game.points
                  .where(game_number: @game.current_game_number)
                  .where.not(winner: "RESULT")
                  .order(:created_at)
%>

<% points.each do |point| %>

  <%
    number = all_points.index(point) + 1
if point.serve_number == "first"
  marks = ["①","②","③","④","⑤","⑥","⑦","⑧","⑨","⑩"]
  mark = marks[number - 1] || number
else
  mark = number
end

    display_code =
      if point.play_code == "SA" ||
