      end
  %>

  <div><%= mark %><%= display_code %></div>

<% end %>
</div>


<h2>ゲーム結果</h2>

<% @game.points.where(winner: "RESULT").each do |result| %>

  <div class="result-row">

    <span class="game-no">
      <%= result.game_number %>ゲーム
    </span>

    <span class="point-history">
      <% @game.points.where(game_number: result.game_number)
                     .where.not(winner: "RESULT")
                     .each do |point| %>

        <%= point.winner == "P" ? "○" : "×" %>

      <% end %>
    </span>

    <span class="game-score">

      <%
        if result.p_gamescore > result.q_gamescore

          p_display =
            case result.p_gamescore
            when 4 then "④"
            when 5 then "⑤"
            when 6 then "⑥"
            when 7 then "⑦"
            when 8 then "⑧"
            when 9 then "⑨"
            when 10 then "⑩"
            else result.p_gamescore
            end

          q_display = result.q_gamescore

        else

          p_display = result.p_gamescore

          q_display =
            case result.q_gamescore
            when 4 then "④"
            when 5 then "⑤"
            when 6 then "⑥"
            when 7 then "⑦"
            when 8 then "⑧"
            when 9 then "⑨"
            when 10 then "⑩"
            else result.q_gamescore
            end

        end
      %>

      <%= p_display %>-<%= q_display %>

    </span>

  </div>

<% end %>



<% if params[:code].present? %>

  <h2>
    コード：
    <%= params[:code] %>
  </h2>

<% end %>

<%= button_to "← 1本戻る",
      undo_game_path(@game),
      method: :delete,
      class: "undo-btn" %>

<hr>

<div style="text-align:center; margin:30px 0;">
  <%= link_to "試合詳細へ戻る",
      match_path(@game.match) %>
</div>

<br><br>

<%= link_to "次の試合を追加",
    players_match_path(@game.match),
    class: "button" %>

<% end %>