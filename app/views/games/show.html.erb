<%
  p_games = @game.points.where(winner: "RESULT")
                        .where("p_gamescore > q_gamescore")
                        .count

  q_games = @game.points.where(winner: "RESULT")
                        .where("q_gamescore > p_gamescore")
                        .count
%>


<% if p_games == 3 && q_games == 3 %>
